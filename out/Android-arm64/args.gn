target_os = "android"
target_cpu = "arm64"
target_platform = "android"
is_component_build = false
is_debug = false
angle_build_all = false
angle_enable_gl = true
angle_enable_vulkan = true
angle_enable_d3d11 = false
angle_enable_null = false
angle_enable_metal = false
enable_iterator_debugging = false
symbol_level = 0
dcheck_always_on = false
angle_assert_always_on = false
is_clang = true
android_ndk_api_level = 26
strip_debug_info = true
enable_resource_allowlist_generation = false
angle_enable_vulkan = true
angle_enable_vulkan_validation_layers = false
angle_enable_swiftshader = false
angle_enable_essl = true ###
angle_enable_glsl = true ###
angle_enable_hlsl = false
angle_enable_cgl = false
angle_build_all = false ### true/ error is_official_build = true
angle_expose_non_conformant_extensions_and_versions = true
build_angle_deqp_tests = false
angle_build_tests = false
use_thin_lto = true
angle_enable_custom_vulkan_cmd_buffers = true ###
angle_enable_custom_vulkan_outside_render_pass_cmd_buffers = true ###
angle_enable_custom_vulkan_render_pass_cmd_buffers = true ###
is_official_build = true ### false for first build, only problem ons arm64
angle_standalone = true ### false or true for first build
angle_use_vulkan_display = true ####
angle_has_histograms = false
angle_has_rapidjson = false
arm_control_flow_integrity = "none" ### only arm64
use_relative_vtables_abi = true #####
enable_android_secondary_abi = false ####
#angle_enable_abseil = false #or true
treat_warnings_as_errors = false
angle_vulkan_display_mode = "simple" #simple ####
use_cxx23 = true ####
optimize_for_size = false
use_sized_deallocation = true
chrome_pgo_phase = 0

exclude_unwind_tables = true
thin_lto_enable_cache = true
enable_incremental_d8 = true
use_autogenerated_modules = false
enable_proguard_obfuscation = true
android_static_analysis = "off"

# THIS IS CURRENTLY EXPERIMENTAL.
angle_ir = true ####or true
angle_enable_perfetto = false

angle_extra_cflags = [
  "-Wno-error=unused-variable",
  "-Wno-unused-variable",
  "-Wno-error=extra-semi-stmt",
  "-Wno-extra-semi-stmt",
  "-Wno-error=unsafe-buffer-usage",
  "-Wno-unused-function",
  "-Wno-unused-but-set-variable",
  "-Wno-unused-command-line-argument",
  "-Wno-error",
  "-O3",
  "-fno-semantic-interposition",
  "-mllvm",
  "-hot-cold-split=true",
  "-fdata-sections",
  "-ffunction-sections",
  "-fmerge-all-constants",
  "-ftree-vectorize",
  "-fvectorize",
  "-fslp-vectorize",
  "-pipe",
  "-integrated-as",
  "-mllvm",
  "-inlinehint-threshold=100000",
  "-flto",
  "-D_FILE_OFFSET_BITS=64",
  "-D__USE_BSD",
  "-D_ALLBSD_SOURCE",
  "-DUNSAFE_BUFFERS_BUILD"
]

angle_extra_cflags_cc = [
  "-Wno-error=unused-variable",
  "-Wno-unused-variable",
  "-Wno-error=extra-semi-stmt",
  "-Wno-extra-semi-stmt",
  "-Wno-error=unsafe-buffer-usage",
  "-Wno-unused-function",
  "-Wno-unused-but-set-variable",
  "-Wno-unused-command-line-argument",
  "-Wno-error",
  "-O3",
  "-fno-semantic-interposition",
  "-mllvm",
  "-hot-cold-split=true",
  "-fdata-sections",
  "-ffunction-sections",
  "-fmerge-all-constants",
  "-ftree-vectorize",
  "-fvectorize",
  "-fslp-vectorize",
  "-pipe",
  "-integrated-as",
  "-mllvm",
  "-inlinehint-threshold=100000",
  "-flto",
  "-D_FILE_OFFSET_BITS=64",
  "-D__USE_BSD",
  "-D_ALLBSD_SOURCE",
  "-DUNSAFE_BUFFERS_BUILD"
]

angle_extra_ldflags = [
  "-fuse-ld=lld",
  "-Wl,--gc-sections",
  "-flto",
  "-Wl,--lto-O3",
  "-Wl,-O3",
  "-Wl,--as-needed"
]
